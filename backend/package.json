{
  "name": "paranoid-planner-backend",
  "version": "1.0.0",
  "description": "ParanoidPlanner backend - study scheduling application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:auth",
    "test:unit": "node --test",
    "test:auth": "jest --runInBand --silent"
  },
  "keywords": [
    "study",
    "planner",
    "scheduler"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.spec.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setupEnv.js"
    ]
  }
}
