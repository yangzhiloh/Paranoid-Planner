# Set to production on Render so the refresh cookie is marked Secure.
NODE_ENV=development
PORT=5000

# Authentication
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
# Access tokens expire after 15 minutes and refresh tokens after 7 days (fixed in services/tokenService.js).
JWT_SECRET=

# Frontend origin allowed by CORS (no trailing slash), e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of the backend, used to find the client IP for rate limiting.
TRUST_PROXY=1

# Database: use DATABASE_URL for hosted Postgres, or local DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional AI-assisted scheduling.
# AI scheduling remains disabled unless AI_SCHEDULING_ENABLED=true
# and the provider URL, API key, and model are set.
AI_SCHEDULING_ENABLED=false
AI_PROVIDER_NAME=
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=15000

# Auth tests (npm run test:auth) use a separate Postgres database, which must end in _test.
# Defaults: localhost, 5432, planner, planner, paranoid_planner_test.
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=paranoid_planner_test
