NODE_ENV=development
PORT=5000

# Authentication
JWT_SECRET=
JWT_EXPIRE=7d

# Database: use DATABASE_URL for hosted Postgres, or local DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional AI-assisted scheduling.
# AI scheduling remains disabled unless AI_SCHEDULING_ENABLED=true
# and AI_PROVIDER_API_KEY is set.
AI_SCHEDULING_ENABLED=false
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=15000
