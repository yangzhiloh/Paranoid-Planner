# Base URL for API calls. Leave unset to use same-origin /api, which Vercel rewrites to the backend
# (see vercel.json) and the Vite dev server proxies. Setting a cross-origin URL here breaks the
# SameSite=Strict refresh cookie, so sessions will not survive a page reload.
VITE_API_URL=

# Development only: backend that the Vite dev server proxies /api to.
VITE_DEV_API_PROXY=http://localhost:5000
